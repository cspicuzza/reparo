# Copy to .env (gitignored). Every variable here is validated at startup by packages/shared/env.ts.
# Local values come from `supabase start` output; production values from the Supabase and Vercel dashboards.

# --- Supabase (web, public) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Supabase (api, server-only; never expose to the browser) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
APP_ENV=local            # local | preview | production
