# Copy to .env (gitignored). Every variable here is validated at startup by packages/shared/src/env.ts.
# Local values come from `supabase start` output ("Project URL", "Publishable", "Secret", database "URL");
# production values from the Supabase dashboard → Connect. Key model: https://supabase.com/docs/guides/api/api-keys

# --- Supabase (web, public) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_... — safe in the browser; RLS limits what it can reach.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (api, server-only; never expose to the browser) ---
SUPABASE_URL=http://127.0.0.1:54321
# sb_secret_... — bypasses RLS. Server only.
SUPABASE_SECRET_KEY=
# Public keys for verifying user access tokens (ES256); the API never uses a shared JWT secret.
# Hosted: https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json — https://supabase.com/docs/guides/auth/signing-keys
# Local stack serves the same path (verified 2026-10-13: `curl` returned an ES256 key).
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
APP_ENV=local            # local | preview | production
# API_PORT=3001            # local API dev server (packages/api/src/dev.ts); Vite proxies /api here

# --- Seed (packages/db) ---
# Who may sign in, as email:role pairs. Roles: admin | editor | viewer (ADR-008).
MEMBERS=you@example.com:admin,partner@example.com:editor,guest@example.com:viewer

# --- Supabase local Auth → Google (read by `supabase start` via env() in supabase/config.toml) ---
# From the Google Cloud OAuth client created in OD-26. Authorized redirect URI for local:
# http://127.0.0.1:54321/auth/v1/callback — https://supabase.com/docs/guides/auth/social-login/auth-google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
