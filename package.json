{
  "name": "reparo",
  "private": true,
  "version": "0.0.0",
  "description": "Home-renovation management for a household acting as its own general contractor.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @reparo/web --filter @reparo/api dev",
    "build": "pnpm --filter @reparo/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "pnpm --filter @reparo/db generate",
    "db:migrate": "pnpm --filter @reparo/db migrate",
    "db:studio": "pnpm --filter @reparo/db studio",
    "db:seed": "pnpm --filter @reparo/db seed",
    "db:import": "pnpm --filter @reparo/api run import-spreadsheet",
    "db:import-images": "pnpm --filter @reparo/api run import-images"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "type": "module"
}
